          <h1 className="mt-4 text-4xl font-black text-white">
            Sign in to view Portfolio Intelligence
          </h1>
          <Link
            href="/auth/login"
            className="mt-8 inline-flex rounded-2xl bg-[#D8B65A] px-6 py-4 text-sm font-black text-black"
          >
            Sign In
          </Link>
        </div>
      </main>
    )
