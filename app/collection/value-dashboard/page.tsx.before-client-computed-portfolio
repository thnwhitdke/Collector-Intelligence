            value={radar?.volatileAssets ?? 0}
            helper="Pricing or market instability"
            tone="rose"
            active={signalFilter === 'volatile'}
            onClick={() => setSignalFilter(signalFilter === 'volatile' ? 'all' : 'volatile')}
          />
          <Signal
            label="💎 Elite Holdings"
            value={radar?.eliteValueAssets ?? 0}
            helper="Premium portfolio assets"
            tone="fuchsia"
            active={signalFilter === 'elite_value'}
            onClick={() => setSignalFilter(signalFilter === 'elite_value' ? 'all' : 'elite_value')}
          />
        </section>

        <section className="grid gap-6 xl:grid-cols-[0.95fr_1.05fr]">
          <div className="rounded-[34px] border border-cyan-500/20 bg-cyan-500/[0.06] p-6">
            <p className="text-xs font-black uppercase tracking-[0.3em] text-cyan-300">
              Portfolio Growth Intelligence
