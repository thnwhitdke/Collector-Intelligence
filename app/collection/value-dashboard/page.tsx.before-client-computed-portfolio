            value={radar?.acceleratingAssets ?? 0}
            helper="Momentum signals detected"
            tone="cyan"
            active={signalFilter === 'accelerating'}
            onClick={() => setSignalFilter(signalFilter === 'accelerating' ? 'all' : 'accelerating')}
          />
          <Signal
