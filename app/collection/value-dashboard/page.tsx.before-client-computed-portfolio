                    <h3 className="mt-2 text-4xl font-black text-white">
                      {record.title}
                    </h3>
                    <p className="mt-3 text-sm text-[#A89782]">
                      {[record.label, record.year_released].filter(Boolean).join(' • ') || 'Release details pending'}
